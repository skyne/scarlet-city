# Scarlet Protocol Definition Language (SPDL)
# Source of truth for client/server wire types.
# Generate platform code:
#   python3 shared/codegen/generate.py
#
# JSON encoding:
#   - structs: objects with snake_case fields
#   - enums: strings matching variant names
#   - unions: internally tagged objects, discriminator field "type"

protocol scarlet.city version 7
json tagged "type"

# --- primitives mapped by codegen: f32 f64 u8 u16 u32 u64 i32 i64 bool string uuid ---

struct Vec3 {
  x: f32
  y: f32
  z: f32
}

struct Aabb3 {
  x: f32
  y: f32
  width: f32
  depth: f32
  z_min: f32
  z_max: f32
}

enum VehicleKind {
  GroundCar
  HoverCraft
}

enum LootTier {
  Common
  Rare
  Epic
}

enum HeistKind {
  Vault
  Terminal
  Cargo
}

enum HeistState {
  Locked
  Ready
  InProgress
  Breached
  Looted
  Cooldown
}

enum HitKind {
  Wall
  Vehicle
  Actor
}

enum OrderType {
  Follow
  Hold
  MoveOrDriveTo
  Engage
}

struct Road {
  id: string
  x: f32
  y: f32
  width: f32
  depth: f32
}

struct Obstacle {
  id: string
  x: f32
  y: f32
  width: f32
  depth: f32
  z_min: f32
  z_max: f32
}

struct VehicleSpawn {
  id: uuid
  kind: VehicleKind
  x: f32
  y: f32
  z: f32
  yaw: f32
}

struct LootZone {
  id: string
  x: f32
  y: f32
  width: f32
  depth: f32
  z_min: f32
  z_max: f32
  tier: LootTier
}

struct ExfilZone {
  id: string
  x: f32
  y: f32
  width: f32
  depth: f32
  z_min: f32
  z_max: f32
  duration_secs: f32
}

struct HeistSite {
  id: string
  name: string
  kind: HeistKind
  x: f32
  y: f32
  width: f32
  depth: f32
  z_min: f32
  z_max: f32
  quiet_x: f32
  quiet_y: f32
  quiet_z: f32
  quiet_secs: f32
  loud_x: f32
  loud_y: f32
  loud_z: f32
  loud_secs: f32
  loot_tier: LootTier
}

struct MapBounds {
  x: f32
  y: f32
  width: f32
  depth: f32
}

struct MapData {
  name: string
  bounds: MapBounds
  ground_z: f32
  max_altitude: f32
  roads: Road[]
  obstacles: Obstacle[]
  vehicle_spawns: VehicleSpawn[]
  loot_zones: LootZone[]
  exfil_zones: ExfilZone[]
  heist_sites: HeistSite[]
}

struct StashItem {
  id: uuid
  item_type: string
  item_name: string
  quantity: u32
  stats_json: string
}

struct CharacterAppearance {
  body_set: string
  hair: string
  outfit: string
  beard: bool
  brows: bool
  hair_color: string
  beard_color: string
  eye_color: string
  skin_color: string
  outfit_color: string
  height: f32
  head: f32
  neck: f32
  shoulders: f32
  bust: f32
  waist: f32
  hips: f32
  bum: f32
  muscle: f32
  arms: f32
  legs: f32
  leg_length: f32
  torso_length: f32
  slot_top: string
  slot_bottom: string
  slot_shoes: string
  slot_gloves: string
  slot_head: string
  slot_shoulder: string
  slot_belt: string
  weapon: string
}

struct CrewMember {
  actor_id: uuid
  name: string
  role: string
  hp: f32
  max_hp: f32
  is_ai: bool
  order_label: string
  order_x: f32
  order_y: f32
  order_z: f32
  appearance: CharacterAppearance
}

struct PlayerState {
  id: uuid
  player_id: uuid
  squad_id: uuid
  name: string
  role: string
  is_ai: bool
  x: f32
  y: f32
  z: f32
  yaw: f32
  vx: f32
  vy: f32
  vz: f32
  health: f32
  armor: f32
  backpack: StashItem[]
  vehicle_id: uuid?
  extracting: bool
  extract_progress: f32
  last_processed_input_seq: u32
  appearance: CharacterAppearance
}

struct VehicleState {
  id: uuid
  kind: VehicleKind
  x: f32
  y: f32
  z: f32
  yaw: f32
  speed: f32
  hp: f32
  driver_id: uuid?
  law: bool
}

struct HeistMarker {
  id: string
  name: string
  kind: HeistKind
  state: HeistState
  x: f32
  y: f32
  z: f32
  quiet_x: f32
  quiet_y: f32
  quiet_z: f32
  loud_x: f32
  loud_y: f32
  loud_z: f32
  progress: f32
  approach: string
  alarm: bool
  owner_squad: uuid?
}

struct AlarmPing {
  id: string
  x: f32
  y: f32
  z: f32
  radius: f32
  kind: string
  intensity: f32
}

struct NpcState {
  id: uuid
  kind: string
  x: f32
  y: f32
  z: f32
  yaw: f32
  health: f32
  alert: bool
  vehicle_id: uuid?
}

struct Impact {
  x: f32
  y: f32
  z: f32
  from_x: f32
  from_y: f32
  from_z: f32
  hit_kind: HitKind
}

struct LootNode {
  id: uuid
  x: f32
  y: f32
  z: f32
  tier: LootTier
  taken: bool
  respawn_secs: f32
}

struct DeathCrate {
  id: uuid
  x: f32
  y: f32
  z: f32
  items: StashItem[]
}

struct Projectile {
  id: uuid
  x: f32
  y: f32
  z: f32
  vx: f32
  vy: f32
  vz: f32
  owner_id: uuid
}

union ClientMessage {
  Join {
    name: string
  }
  GetProfile {
  }
  Deploy {
    loadout_item_ids: uuid[]
    crew_ids: uuid[]
    join_squad_id: uuid?
  }
  SwapActor {
    target_actor_id: uuid
  }
  SetCrewAppearance {
    crew_id: uuid
    appearance: CharacterAppearance
  }
  SetCrewName {
    crew_id: uuid
    name: string
  }
  SquadOrder {
    order_type: OrderType
    target_actor_id: uuid?
    x: f32
    y: f32
    z: f32
  }
  Input {
    seq: u32
    dt: f32
    move_x: f32
    move_y: f32
    ascend_descend: f32
    aim_angle: f32
    shoot: bool
    interact: bool
    brake: bool
  }
  Ping {
    client_ms: u64
  }
}

union ServerMessage {
  Welcome {
    player_id: uuid
    actor_id: uuid?
    map: MapData
  }
  ProfileState {
    cash: i32
    stash: StashItem[]
    deployed_loadout: StashItem[]
    actor_id: uuid?
    squad_id: uuid?
    controlled_actor_id: uuid?
    crew: CrewMember[]
  }
  Snapshot {
    tick: u64
    last_processed_input_seq: u32
    squad_id: uuid?
    controlled_actor_id: uuid?
    crew: CrewMember[]
    players: PlayerState[]
    vehicles: VehicleState[]
    loot_nodes: LootNode[]
    death_crates: DeathCrate[]
    exfil_zones: ExfilZone[]
    projectiles: Projectile[]
    impacts: Impact[]
    heists: HeistMarker[]
    heat: f32
    stars: u8
    alarms: AlarmPing[]
    npcs: NpcState[]
  }
  RaidEnded {
    outcome: string
    cash: i32
    cash_delta: i32
    items_banked: StashItem[]
    message: string
  }
  Event {
    kind: string
    message: string
  }
  Pong {
    client_ms: u64
    server_tick: u64
  }
}
